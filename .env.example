# ---- Ascend environment variables ----
# Copy to .env.local (never commit real values).

# ---- Hosting ----
# One password in front of every page. Set it on any public deployment: the app has no accounts.
APP_PASSWORD=
# Signs the sign-in cookie (optional; defaults to the password).
AUTH_SECRET=

# Path to the SQLite database file. Created automatically on first run.
DATABASE_PATH=./data/ascend.db

# ---- Oura Ring (optional) ----
# Option A: Personal Access Token (simplest for a single-user app).
# Create one at https://cloud.ouraring.com/personal-access-tokens
OURA_PERSONAL_ACCESS_TOKEN=

# Option B: OAuth2 application (needed if Oura retires personal tokens for your account).
# Register an app at https://cloud.ouraring.com/oauth/applications
# Redirect URI must be: <APP_URL>/api/oura/callback
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# Public URL of this app (used to build the Oura OAuth redirect URI).
APP_URL=http://localhost:3000

# How often the server pulls the last 3 days from Oura by itself (hours; 0 = off).
OURA_AUTO_SYNC_HOURS=3

# ---- Optional AI features (not required; the app works fully without them) ----
# Provider: "openai" (any OpenAI-compatible chat/completions API) or "anthropic".
# The key can also be entered in Settings → AI provider instead of here.
AI_PROVIDER=
AI_API_KEY=
# Model id. Defaults: gpt-4o-mini (openai) / claude-haiku-5-5 (anthropic)
AI_MODEL=
# Optional base URL override (e.g. http://localhost:11434/v1 for Ollama, or Groq)
AI_BASE_URL=

# ---- Apple Health bridge (optional) ----
# Static ingest token accepted by POST /api/health/ingest in addition to the one generated in
# Settings → Connected services. Leave empty to use only the generated token.
HEALTH_INGEST_TOKEN=
# Set to "off" to disable live Open Food Facts lookups in food search (local data still works).
FOOD_SEARCH_LIVE=
