# ---- Ascend environment variables ----
# Copy to .env.local (never commit real values).

# Path to the SQLite database file. Created automatically on first run.
DATABASE_PATH=./data/ascend.db

# ---- Oura Ring (optional) ----
# Option A: Personal Access Token (simplest for a single-user app).
# Create one at https://cloud.ouraring.com/personal-access-tokens
OURA_PERSONAL_ACCESS_TOKEN=

# Option B: OAuth2 application (needed if Oura retires personal tokens for your account).
# Register an app at https://cloud.ouraring.com/oauth/applications
# Redirect URI must be: <APP_URL>/api/oura/callback
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# Public URL of this app (used to build the Oura OAuth redirect URI).
APP_URL=http://localhost:3000

# ---- Optional AI features (not required; the app works fully without them) ----
# ANTHROPIC_API_KEY=
